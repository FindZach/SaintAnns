# Our Lady of the Valley Parish — environment variables.
# Copy to .env (local) or add to Easypanel service env (prod) and fill in.
# DB_HOST, DB_PASSWORD, JWT_SECRET and SESSION_SECRET have no defaults — the
# server refuses to start without them.

# ================ Server ================
PORT=8080
GIN_MODE=debug           # "release" in production — enables Secure cookies, hides stack traces, cuts log noise.

# ================ Database (PostgreSQL) ================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=olv_parish
DB_SSLMODE=disable       # "require" / "verify-full" when Postgres is behind TLS.

# ================ Security ================
# Each must be at least 32 random characters. Validate() rejects anything
# starting with "your-" so the placeholder below WILL be refused.
# Generate: openssl rand -base64 48
JWT_SECRET=your-replace-me-with-32-plus-random-chars
SESSION_SECRET=your-replace-me-with-32-plus-random-chars

# ================ URLs ================
# Public URL the site is served from. Used for CORS allowlist. Set to the
# parish domain (or the Easypanel subdomain while in staging).
FRONTEND_URL=http://localhost:8080

# ================ Catholic Courier feed (optional) ================
# RSS feed used by the home page. Leaving it unset uses the baked-in default
# (https://catholiccourier.com/feed/). Override only if the feed URL changes.
# COURIER_FEED_URL=https://catholiccourier.com/feed/

# ================ Email / notifications (optional) ================
# Parish-registration submissions email the office when SMTP is configured. If
# SMTP_HOST is empty, the mailer logs the message to stderr instead of sending
# — safe default so dev doesn't accidentally spam anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=              # Address the parish office sees as the sender.
PARISH_NOTIFY_EMAIL=     # Recipient for registration notifications; defaults to EMAIL_FROM, then the siteInfo.Email.

# ================ First-admin bootstrap (optional) ================
# When set, `go run main.go --create-admin` upserts a user with role=admin.
# Use this on first deploy, then unset. Password must be at least 8 chars.
# ADMIN_EMAIL=parish-office@example.org
# ADMIN_PASSWORD=change-me-at-least-8-chars
